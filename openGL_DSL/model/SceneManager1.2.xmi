              Altura="100.0">
            <Color
                B="1.0"
                A="1.0"/>
          </abs_entity>
          <posicion
              Z="170.0"/>
        </nodo>
        <nodo
            Name="boca">
          <abs_entity
              xsi:type="openGL_DSL:DiscoParcial"
              RadioInterno="50.0"
              RadioExterno="100.0"
