<?xml version="1.0" encoding="UTF-8"?>
<openGL_DSL:SceneManager
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:openGL_DSL="http://www.example.org/openGL_DSL">
  <camera>
    <Eye X="500.0"
        Y="500.0"
        Z="500.0"/>
  </camera>
  <scenes Name="persona_en_campo">
    <nodo Name="luz">
      <light
          xsi:type="openGL_DSL:DirLight">
        <direccion
            Y="1.0"
            Z="1.0"/>
      </light>
    </nodo>
    <nodo Name="ejes">
      <abs_entity
          xsi:type="openGL_DSL:EjesRGB"
          Lenght="500.0"/>
    </nodo>
    <nodo Name="persona">
      <nodo
          Name="cabeza">
        <nodo
            Name="ojos">
          <nodo
              Name="ojoD">
            <abs_entity
                xsi:type="openGL_DSL:Esfera"
                Radio="30.0">
              <Color
                  R="1.0"
                  B="1.0"
                  A="1.0"/>
            </abs_entity>
            <posicion
                X="60.0"/>
          </nodo>
          <nodo
              Name="ojoI">
            <abs_entity
                xsi:type="openGL_DSL:Esfera"
                Radio="30.0">
              <Color
                  R="1.0"
                  B="1.0"
                  A="1.0"/>
            </abs_entity>
            <posicion
                X="-60.0"/>
          </nodo>
          <posicion
              Y="80.0"
              Z="170.0"/>
        </nodo>
        <nodo
            Name="nariz">
          <abs_entity
              xsi:type="openGL_DSL:Cilindro"
