        <body xsi:type="ocl.ecore:StringLiteralExp" stringSymbol=" vIndices; }&#xA;&#x9;virtual void render() const;&#xA;&#x9;virtual void draw() const;&#xA;&#x9;void buildNormalVectors();&#xA;&#xA;&#x9;static IndexMesh* generateIndexedBox(GLdouble l, GLuint rw, GLuint rh);&#xA;};&#xA;&#xA;class MbR : public IndexMesh {&#xA;protected:&#xA;&#x9;int n;&#xA;&#x9;glm::dvec3* perfil = nullptr;&#xA;&#x9;int m;&#xA;public:&#xA;&#x9;MbR(int n, glm::dvec3* perfil, int m):n(n), perfil(perfil), m(m) {};&#xA;&#x9;virtual ~MbR() { delete"/>
