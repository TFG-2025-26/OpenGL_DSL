[module generateClasses('http://www.example.org/openGL_DSL')]

[import openGL_acceleo_impl::files::viewportFile /]
[import openGL_acceleo_impl::files::cameraFile /]
[import openGL_acceleo_impl::files::sceneFile /]
[import openGL_acceleo_impl::files::nodeFile /]
[import openGL_acceleo_impl::files::lightFile /]
[import openGL_acceleo_impl::files::entityFile /]
[import openGL_acceleo_impl::files::meshFile /]
[import openGL_acceleo_impl::files::textureFile /]
[import openGL_acceleo_impl::files::materialFile /]

[template public generateClasses()]
[generateViewport()/]
[generateCamera()/]
[generateScene()/]
[generateNode()/]
[generateLight()/]
[generateEntity()/]
[generateMesh()/]
[generateTexture()/]
[generateMaterial()/]
[/template]